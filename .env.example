# Application Server Configuration
PORT=3001
NODE_ENV=development
APP_URL=https://aasthaserasta.com

# Hostinger MySQL Database Credentials
# For Hostinger Shared Hosting, create a MySQL Database in hPanel/cPanel and fill in details below:
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_aastha
DB_PASSWORD=YourSecureHostingerPassword
DB_NAME=u123456789_aasthadb

# Admin Security Configuration
JWT_SECRET=super_secret_jwt_key_aastha_2026

# Database Auto-Seeding Guard
# In production on Hostinger, once your database is created, set this to true
# to prevent any automatic seeding from touching your live database records.
DISABLE_AUTO_SEED=false

# Persistent Upload Storage (Crucial for Hostinger / CI-CD Deployments)
# By default locally, images are saved to 'public/assets/images'.
# On Hostinger or production CI/CD servers, specify a path OUTSIDE your Git repository root
# so that Git pulls / deployments never delete or overwrite uploaded images.
# Example for Hostinger VPS/cPanel:
# UPLOAD_PATH=/home/u123456789/persistent_uploads/images
# Or relative/absolute custom path:
UPLOAD_PATH=public/assets/images

